# Example TLS termination for phone access. Mount cert/key into the web container
# and replace nginx.conf with this file (or include it from your reverse proxy).
#
# With Let's Encrypt on the host:
#   certbot certonly --webroot -w /var/www/certbot -d fantasy.yourdomain.com
#   mount /etc/letsencrypt/live/fantasy.yourdomain.com/fullchain.pem -> /etc/nginx/tls/fullchain.pem
#   mount /etc/letsencrypt/live/fantasy.yourdomain.com/privkey.pem   -> /etc/nginx/tls/privkey.pem

server {
    listen 80;
    server_name fantasy.yourdomain.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name fantasy.yourdomain.com;

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    root /usr/share/nginx/html;
    index index.html;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /api/ {
        proxy_pass http://api:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /health/ {
        proxy_pass http://api:8000/health/;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
