# Production deployment template for Supabase + Vercel. Configure these in the
# hosting dashboards; do not create or commit a populated production .env file.

# Application
APP_ENV=production
APP_SECRET_KEY=replace-with-long-random-secret
APP_ALLOWED_EMAIL=owner@example.com
APP_ENABLE_DEV_AUTH=false
APP_PUBLIC_URL=https://fantasy-projections-xi.vercel.app
APP_CORS_ORIGINS=https://fantasy.example.com
TRUSTED_HOSTS=fantasy.example.com

# Supabase PostgreSQL. Use the transaction pooler for request traffic, the
# session pooler for jobs, and a direct connection for Alembic migrations.
DATABASE_URL=postgresql+psycopg://fantasy_app_runtime:replace-me@pooler.example.com:6543/postgres
JOB_DATABASE_URL=postgresql+psycopg://fantasy_app_runtime:replace-me@pooler.example.com:5432/postgres
MIGRATION_DATABASE_URL=postgresql+psycopg://fantasy_app_migrator:replace-me@db.example.supabase.co:5432/postgres
EXPECTED_ALEMBIC_REVISION=f1e2d3c4b5a6

# Supabase Storage through its S3-compatible endpoint.
ARTIFACT_BACKEND=s3
ARTIFACT_LOCAL_ROOT=output/app_artifacts
S3_ENDPOINT_URL=https://project-ref.storage.supabase.co/storage/v1/s3
S3_BUCKET=fantasy-app
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_REGION=us-east-1

# Sleeper (read-only). Prefer inline JSON on Vercel because the real owner
# configuration intentionally remains outside Git.
SLEEPER_USERNAME=replace-me
SLEEPER_USER_ID=
SLEEPER_OWNER_CONFIG=config/sleeper_owner.json
SLEEPER_OWNER_JSON={"allowed_league_ids":["replace-me"],"dynasty_rules":{}}
SLEEPER_USE_FIXTURES=false

# Injury research: sleeper uses Sleeper status evidence; live also requires an
# OpenAI key.
INJURY_RESEARCH_MODE=sleeper

# Email magic links (required for phone sign-in).
EMAIL_PROVIDER=resend
EMAIL_FROM=Fantasy Assistant <noreply@fantasy.example.com>
RESEND_API_KEY=replace-me
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=replace-me
# SMTP_PASSWORD=replace-me

# Optional OpenAI assistant and live injury research.
OPENAI_API_KEY=
OPENAI_COST_SENSITIVE_MODEL=gpt-4.1-mini
OPENAI_BALANCED_MODEL=gpt-4.1
OPENAI_MONTHLY_WARNING_USD=30
OPENAI_MONTHLY_SOFT_LIMIT_USD=45
OPENAI_MONTHLY_HARD_LIMIT_USD=55

# Projection pipeline.
FANTASY_PROJECTIONS_DATA_DIR=
SIMULATION_DRAW_COUNT=10000
APP_PROJECTION_SOURCE=sealed_release
WEEKLY_RND_ENABLED=false
STATUS_OVERLAY_AUTO_PUBLISH=true

# Scheduled jobs and alerts.
CRON_SECRET=replace-with-an-independent-long-random-secret
ALERT_EMAIL_TO=owner@example.com
LONG_JOBS_EXTERNAL=false

# Logging.
LOG_LEVEL=INFO
LOG_JSON=true
