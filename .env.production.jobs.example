# Copy to .env.production.jobs (gitignored) and fill from the Vercel production dashboard.
# Then run: pwsh scripts/set_production_job_env_secret.ps1

APP_ENV=production
APP_SECRET_KEY=replace-with-long-random-secret
APP_ALLOWED_EMAIL=owner@example.com
APP_ENABLE_DEV_AUTH=false
APP_PUBLIC_URL=https://fantasy-projections-xi.vercel.app
APP_CORS_ORIGINS=https://fantasy-projections-xi.vercel.app
TRUSTED_HOSTS=fantasy-projections-xi.vercel.app,fantasy-projections-rdfergus15.vercel.app

DATABASE_URL=postgresql+psycopg://fantasy_app_runtime:replace-me@aws-0-us-west-1.pooler.supabase.com:6543/postgres
JOB_DATABASE_URL=postgresql+psycopg://fantasy_app_runtime:replace-me@aws-0-us-west-1.pooler.supabase.com:5432/postgres

ARTIFACT_BACKEND=s3
S3_ENDPOINT_URL=https://dbvwgfefdorugdtpxgcj.storage.supabase.co/storage/v1/s3
S3_BUCKET=fantasy-app
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_REGION=us-east-1

SLEEPER_USERNAME=replace-me
SLEEPER_USER_ID=replace-me
SLEEPER_USE_FIXTURES=false
INJURY_RESEARCH_MODE=sleeper

EMAIL_PROVIDER=resend
EMAIL_FROM=Fantasy Assistant <noreply@example.com>
RESEND_API_KEY=replace-me

APP_PROJECTION_SOURCE=sealed_release
WEEKLY_RND_ENABLED=false
STATUS_OVERLAY_AUTO_PUBLISH=true
LOG_LEVEL=INFO
LOG_JSON=true
