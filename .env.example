# Application
APP_ENV=development
APP_SECRET_KEY=replace-with-long-random-secret
APP_ALLOWED_EMAIL=owner@example.com
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENABLE_DEV_AUTH=true
APP_PUBLIC_URL=http://localhost:5173
# Hostnames the API will answer to. Production must name them explicitly;
# startup refuses to boot with "*" when APP_ENV=production.
TRUSTED_HOSTS=*

# Database
# Default: zero-dependency local file, so the README quick start runs with no
# PostgreSQL and no Docker. Production refuses to start on SQLite.
DATABASE_URL=sqlite+pysqlite:///./local_app.db
# Session pooler for job workers (Supabase port 5432). Falls back to DATABASE_URL when unset.
# JOB_DATABASE_URL=postgresql+psycopg://fantasy_app_runtime:***@db.xxx.supabase.co:5432/postgres
# Direct connection for Alembic migrations only (CI / manual migrate).
# MIGRATION_DATABASE_URL=postgresql+psycopg://fantasy_app_migrator:***@db.xxx.supabase.co:5432/postgres
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:
# Artifacts
ARTIFACT_BACKEND=local
ARTIFACT_LOCAL_ROOT=output/app_artifacts
S3_ENDPOINT_URL=
S3_BUCKET=fantasy-app
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# Sleeper (read-only)
SLEEPER_USERNAME=
SLEEPER_USER_ID=
# Owner league selection: file path (local) or inline JSON for Vercel.
SLEEPER_OWNER_CONFIG=config/sleeper_owner.json
# SLEEPER_OWNER_JSON={"allowed_league_ids":["..."],"dynasty_rules":{...}}
# Leave unset to follow APP_ENV (fixtures outside production). Set explicitly to
# read the real read-only Sleeper API from a non-production environment.
# Production refuses to start with fixtures enabled.
# SLEEPER_USE_FIXTURES=false

# Injury research: fixture | sleeper | live | disabled. Unset follows APP_ENV.
# `sleeper` cites Sleeper players/nfl status; `live` requires OPENAI_API_KEY.
INJURY_RESEARCH_MODE=

# Email magic link
EMAIL_PROVIDER=development
EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# OpenAI assistant (optional)
OPENAI_API_KEY=
OPENAI_COST_SENSITIVE_MODEL=gpt-4.1-mini
OPENAI_BALANCED_MODEL=gpt-4.1
OPENAI_MONTHLY_WARNING_USD=30
OPENAI_MONTHLY_SOFT_LIMIT_USD=45
OPENAI_MONTHLY_HARD_LIMIT_USD=55

# Projection pipeline
FANTASY_PROJECTIONS_DATA_DIR=
SIMULATION_DRAW_COUNT=10000
# Production projection source: sealed_release (default) | status_adjusted_release | weekly_v2_rnd
APP_PROJECTION_SOURCE=sealed_release
# Explicit opt-in for weekly-v2 R&D; never selected by default.
WEEKLY_RND_ENABLED=false
# Auto-publish status overlay after gate passes (daily refresh path).
STATUS_OVERLAY_AUTO_PUBLISH=true

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Production deployment (Supabase + Vercel)
# CRON_SECRET=generate-long-random-secret
# EXPECTED_ALEMBIC_REVISION=f1e2d3c4b5a6
# ALERT_EMAIL_TO=owner@example.com
# LONG_JOBS_EXTERNAL=false
