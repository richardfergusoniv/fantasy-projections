# Application
APP_ENV=development
APP_SECRET_KEY=replace-with-long-random-secret
APP_ALLOWED_EMAIL=owner@example.com
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENABLE_DEV_AUTH=true
APP_PUBLIC_URL=http://localhost:5173
# Hostnames the API will answer to. Production must name them explicitly;
# startup refuses to boot with "*" when APP_ENV=production.
TRUSTED_HOSTS=*

# Database
# Default: zero-dependency local file, so the README quick start runs with no
# PostgreSQL and no Docker. Production refuses to start on SQLite.
DATABASE_URL=sqlite+pysqlite:///./local_app.db
# Local PostgreSQL:
# DATABASE_URL=postgresql+psycopg://fantasy:fantasy@localhost:5432/fantasy_app
# Docker Compose (service name `db`, already set in docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://fantasy:fantasy@db:5432/fantasy_app
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:
# Artifacts
ARTIFACT_BACKEND=local
ARTIFACT_LOCAL_ROOT=output/app_artifacts
S3_ENDPOINT_URL=
S3_BUCKET=fantasy-app
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# Sleeper (read-only)
SLEEPER_USERNAME=
SLEEPER_USER_ID=
# Leave unset to follow APP_ENV (fixtures outside production). Set explicitly to
# read the real read-only Sleeper API from a non-production environment.
# Production refuses to start with fixtures enabled.
# SLEEPER_USE_FIXTURES=false

# Injury research: fixture | live | disabled. Unset follows APP_ENV.
# `live` requires OPENAI_API_KEY; it never falls back to synthetic evidence.
INJURY_RESEARCH_MODE=

# Email magic link
EMAIL_PROVIDER=development
EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# OpenAI assistant (optional)
OPENAI_API_KEY=
OPENAI_COST_SENSITIVE_MODEL=gpt-4.1-mini
OPENAI_BALANCED_MODEL=gpt-4.1
OPENAI_MONTHLY_WARNING_USD=30
OPENAI_MONTHLY_SOFT_LIMIT_USD=45
OPENAI_MONTHLY_HARD_LIMIT_USD=55

# Projection pipeline
FANTASY_PROJECTIONS_DATA_DIR=
SIMULATION_DRAW_COUNT=10000

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
